PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/connectionDB?retryWrites=true&w=majority
JWT_SECRET=generate_a_very_long_secure_random_string_for_access_tokens
JWT_REFRESH_SECRET=generate_another_very_long_secure_random_string_for_refresh_tokens
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Cloudinary Credentials (Required for remote storage in production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
